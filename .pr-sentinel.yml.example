# Example `.pr-sentinel.yml` — place on the repository **default branch**.
# PR branches' copies are ignored; worker always reads default branch.
version: 1
summary_comment: true
check_run: true
inline_comments: true
update_strategy: update   # update | recreate | skip_if_exists
ignore_paths:
  - "docs/**"
  - "**/*.md"
diff:
  max_pages: 5
  per_page: 100
  max_files: 300
rules:
  secrets:
    enabled: true
    patterns:
      - "AKIA[0-9A-Z]{16}"
      - "-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----"
  large_files:
    enabled: true
    max_bytes: 1048576      # patch 字节阈值
    max_additions: 2000
    binary_extensions: [".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".zip", ".gz", ".whl", ".exe", ".dll", ".so", ".dylib", ".bin"]
  weakened_tests:
    enabled: true
privacy:
  redact_secrets: true   # redact before sending patch text to LLM
llm:
  enabled: true
  max_patch_chars: 12000
  temperature: 0.2
analyzer:
  mode: rules+llm   # rules | rules+llm | fake  (no API key → auto skip LLM)
