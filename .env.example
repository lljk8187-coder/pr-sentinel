# --- Webhook ---
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Dev only: skip HMAC verification (never enable in prod)
WEBHOOK_SKIP_VERIFY=false
# Alias also accepted: ALLOW_INSECURE_WEBHOOKS=true

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
QUEUE_KEY=pr-sentinel:jobs

# --- GitHub auth (TOKEN preferred for M1) ---
GITHUB_TOKEN=
# App credentials (placeholder; used when TOKEN is empty)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Path to PEM file alternatively:
# GITHUB_APP_PRIVATE_KEY_PATH=./app.pem

# --- Behavior ---
# When true, read PR files from tests/fixtures and skip real GitHub HTTP
USE_FIXTURES=true
FIXTURES_DIR=tests/fixtures

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
