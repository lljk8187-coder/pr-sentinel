# --- Webhook (HMAC always recommended, including behind smee) ---
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Dev only: skip HMAC (never in prod / never with public smee URL you care about)
WEBHOOK_SKIP_VERIFY=false
# Alias: ALLOW_INSECURE_WEBHOOKS=true

# --- Queue (Redis + arq) ---
REDIS_URL=redis://localhost:6379/0
DELIVERY_DEDUP_PREFIX=pr-sentinel:delivery:
DELIVERY_DEDUP_TTL=604800

# --- GitHub auth ---
# Production (preferred): GitHub App — JWT → installation token (M2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=./app.pem
# Local / fallback: PAT or fine-grained token
GITHUB_TOKEN=

# --- Behavior ---
USE_FIXTURES=true
FIXTURES_DIR=tests/fixtures

# Diff truncation (mirrors built-in / .pr-sentinel.yml defaults; env overlays at runtime)
DIFF_MAX_PAGES=5
DIFF_PER_PAGE=100
DIFF_MAX_FILES=300

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
