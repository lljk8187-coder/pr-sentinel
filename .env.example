# =============================================================================
# REQUIRED (Settings → env names; see packages/common/settings.py)
# =============================================================================
# GITHUB_WEBHOOK_SECRET  → settings.github_webhook_secret  (HMAC for /webhooks/github)
# ADMIN_TOKEN            → settings.admin_token            (console /jobs /metrics; empty → 503)
# DATABASE_URL           → settings.database_url           (Postgres jobs archive)
# REDIS_URL              → settings.redis_url              (arq queue + delivery dedup)
#
# Note: plain WEBHOOK_SECRET is NOT read by Settings — use GITHUB_WEBHOOK_SECRET.
# =============================================================================

# --- [REQUIRED] Webhook HMAC ---
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Dev only: skip HMAC (never in prod / never with public smee URL you care about)
WEBHOOK_SKIP_VERIFY=false
# Alias: ALLOW_INSECURE_WEBHOOKS=true

# --- [REQUIRED] Queue (Redis + arq) ---
# Redis: delivery dedup + arq queue only (jobs archive moved to Postgres in M5)
REDIS_URL=redis://localhost:6379/0
DELIVERY_DEDUP_PREFIX=pr-sentinel:delivery:
DELIVERY_DEDUP_TTL=604800

# --- [REQUIRED] Phase2 M5: Jobs archive (Postgres) ---
DATABASE_URL=postgresql://prsentinel:prsentinel@localhost:5432/prsentinel

# --- [REQUIRED] M4/M5 console / jobs API ---
# Required for GET /jobs and POST /jobs/{id}/retry (and console retry).
# If unset, those endpoints return 503.
ADMIN_TOKEN=change-me-to-a-long-random-admin-token

# --- GitHub auth ---
# Production (preferred): GitHub App — JWT → installation token
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=./app.pem
# Local / fallback: PAT or fine-grained token
GITHUB_TOKEN=

# --- OpenAI-compatible LLM (M3) ---
# Either key works; PR_SENTINEL_OPENAI_API_KEY takes precedence.
# No key → analyzer.mode=rules+llm soft-degrades: rules only, report notes llm_skipped.
OPENAI_API_KEY=
# PR_SENTINEL_OPENAI_API_KEY=
# Optional OpenAI-compatible gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Behavior ---
USE_FIXTURES=true
FIXTURES_DIR=tests/fixtures

# Diff truncation (mirrors built-in / .pr-sentinel.yml defaults; env overlays at runtime)
DIFF_MAX_PAGES=5
DIFF_PER_PAGE=100
DIFF_MAX_FILES=300

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
